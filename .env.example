# Stock API Configuration
# STOCK_API_PROVIDER=auto prefers Finnhub when FINNHUB_API_KEY/VITE_FINNHUB_API_KEY is real,
# falls back to Alpha Vantage when STOCK_API_KEY is real, and otherwise uses mock data.
# Set STOCK_API_PROVIDER=mock for tests/offline runs.
# DEFAULT: mock data for demo (works out of the box with no API keys)
STOCK_API_PROVIDER=auto

# Finnhub API Key (optional - app works with mock data by default)
# 
# TO USE LIVE STOCK DATA:
# 1. Sign up at https://finnhub.io for a free API key (60 requests/minute)
# 2. Replace 'demo' below with your actual API key
# 3. Restart both backend and frontend servers
# 4. Check backend logs for: "Stock data: Using live Finnhub API"
# 5. Look for green "Live" indicator on dashboard
#
# Free tier features: live quotes, company news, market status
# Charts use synthetic history anchored to live prices (no historical candles API on free tier)
FINNHUB_API_KEY=demo
VITE_FINNHUB_API_KEY=demo

# Optional Alpha Vantage API Key (only used when STOCK_API_PROVIDER=alphavantage
# or as a fallback if Finnhub is not configured and STOCK_API_KEY is real)
STOCK_API_KEY=

# OpenAI API Key (optional - AI features gracefully degrade without it)
# Sign up at https://platform.openai.com to get an API key
# Required only for AI portfolio analysis feature
OPENAI_API_KEY=

# OpenAI Model (optional, defaults to gpt-3.5-turbo)
# Options: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview
OPENAI_MODEL=gpt-3.5-turbo

# Database Configuration
DATABASE_URL="file:./dev.db"

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Frontend API URL (for Vite)
VITE_API_URL=http://localhost:3000/api/v1

# Live Price Polling Configuration
# Poll interval when market is open (milliseconds, default: 15000 = 15 seconds)
VITE_POLL_INTERVAL_MARKET_OPEN=15000
# Poll interval when market is closed (milliseconds, 0 = disabled, default: 300000 = 5 minutes)
VITE_POLL_INTERVAL_MARKET_CLOSED=300000

# Demo Mode Price Ticking
# Enable simulated price ticks in mock mode or outside market hours (default: true)
# Set to 'false' to disable animated ticking in demo mode
VITE_DEMO_TICKS=true
